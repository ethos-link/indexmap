#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "tmpdir"
require "rbconfig"
require "uri"

root = File.expand_path("..", __dir__)
url = ENV.fetch("INDEXMAP_DATABASE_URL")
abort "Integration requires a disposable indexmap_test database" unless URI.parse(url).path == "/indexmap_test"
ENV["DATABASE_URL"] = url
ENV["RAILS_ENV"] = "test"
ENV["SECRET_KEY_BASE_DUMMY"] = "1"
ENV["GOOD_JOB_EXECUTION_MODE"] = "external"
ENV["BUNDLE_GEMFILE"] = File.join(root, "gemfiles/integration.gemfile")

def run(*command, directory: nil)
  options = directory ? {chdir: directory} : {}
  raise "Command failed: #{command.first(3).join(" ")}" unless system(*command, **options)
end

Dir.mktmpdir("indexmap-integration") do |directory|
  app = File.join(directory, "crawler_test")
  rails = [RbConfig.ruby, Gem.bin_path("railties", "rails")]
  run(*rails, "new", app, "--skip-bundle", "--skip-git", "--skip-docker", "--skip-javascript",
    "--skip-hotwire", "--skip-asset-pipeline", "--skip-bootsnap", "--skip-dev-gems", "--skip-thruster",
    "--skip-rubocop", "--skip-brakeman", "--skip-bundler-audit", "--skip-ci", "--skip-kamal",
    "--skip-solid", "--skip-jbuilder", "--skip-test", "--skip-system-test", "--database=postgresql", "--quiet")
  command = [RbConfig.ruby, File.join(app, "bin/rails")]
  run(*command, "active_storage:install", directory: app)
  run(*command, "solid_queue:install", directory: app)
  %w[good_job:install indexmap:install].each do |generator|
    run(*command, "generate", generator, "--quiet", directory: app)
  end
  File.write(File.join(app, "config/routes.rb"), <<~CODE)
    Rails.application.routes.draw do
      root to: ->(_env) { [200, {"content-type" => "text/plain"}, ["Home"]] }
    end
  CODE
  File.write(File.join(app, "config/initializers/marketing.rb"), <<~CODE)
    Rails.application.config.x.sitemap_host = "localhost"
  CODE
  initializer = File.join(app, "config/initializers/indexmap.rb")
  template = File.read(initializer).sub(
    'ENV.fetch("INDEXMAP_BASE_URL", "http://localhost:3000")',
    'Rails.application.routes.url_helpers.root_url(host: Rails.configuration.x.sitemap_host, port: 3000, protocol: "http").delete_suffix("/")'
  )
  File.write(initializer, template.sub("# config.sections = -> { Sitemap.sections }", <<~CODE.strip))
    config.format = :single_file
            config.entries = -> { [Indexmap::Entry.new(loc: "http://localhost:3000/")] }
  CODE
  run(*command, "runner", 'abort "Indexmap eagerly loaded" if defined?(Indexmap::Configuration)', directory: app)
  run(*command, "indexmap:sitemap:create", directory: app)
  run(*command, "indexmap:sitemap:validate", directory: app)
  run(*command, "generate", "model", "SitemapArtifact", "filename:string:uniq", "--quiet", directory: app)
  run(*command, "generate", "model", "PublicPage", "slug:string", "published:boolean", "--quiet", directory: app)
  run(*command, "generate", "job", "IntegrationRefresh", "--quiet", directory: app)
  model_path = File.join(app, "app/models/sitemap_artifact.rb")
  File.write(model_path, File.read(model_path).sub("< ApplicationRecord", "< ApplicationRecord\n  has_one_attached :file"))
  File.write(File.join(app, "app/jobs/integration_refresh_job.rb"), <<~CODE)
    class IntegrationRefreshJob < ApplicationJob
      def perform
        require "indexmap"
        Indexmap::TaskRunner.new.create
      end
    end
  CODE
  ENV["INDEXMAP_PATH"] = File.join(directory, "sitemaps")
  File.write(File.join(app, "config/initializers/indexmap.rb"), <<~CODE)
    ActiveSupport.on_load(:indexmap) do
      Indexmap.configure do |config|
        config.base_url = "https://example.com"
        config.index_filename = "sitemap.xml"
        config.format = :index
        config.atomic = true
        config.max_urls = 2
        config.storage = -> { Indexmap::Storage::Filesystem.new(path: ENV.fetch("INDEXMAP_PATH")) }
        config.sections = -> do
          entries = PublicPage.where(published: true).find_each.lazy.map do |page|
            Indexmap::Entry.new(loc: "https://example.com/" + page.slug, lastmod: page.updated_at)
          end
          [Indexmap::Section.new(filename: "sitemap-pages.xml", entries: entries)]
        end
      end
    end
    ActiveJob::Base.queue_adapter = ENV.fetch("INDEXMAP_ADAPTER", "good_job").to_sym
    Rails.application.config.active_storage.service = :test
  CODE
  File.delete(File.join(app, "public/sitemap.xml"))
  File.write(File.join(app, "config/routes.rb"), <<~CODE)
    require "indexmap/sitemaps_controller"

    Rails.application.routes.draw do
      get "/sitemap.xml", to: Indexmap::SitemapsController.action(:show),
        defaults: {filename: "sitemap.xml"}, format: false
      get "/:filename", to: Indexmap::SitemapsController.action(:show),
        constraints: {filename: /sitemap-[a-f0-9]{16}-[a-f0-9]{32}-[1-9][0-9]*-[1-9][0-9]*[.]xml/}, format: false
    end
  CODE
  run(*command, "db:drop", "db:create", "db:migrate", directory: app)
  run(*command, "runner", "load Rails.root.join('db/queue_schema.rb')", directory: app)
  run(*command, "runner", 'PublicPage.create!(slug: "task-check", published: true)', directory: app)
  run(*command, "--tasks", directory: app)
  run(*command, "indexmap:sitemap:create", directory: app)
  run(*command, "indexmap:sitemap:validate", directory: app)
  run(RbConfig.ruby, Gem.bin_path("rake", "rake"), "indexmap:sitemap:validate", directory: app)
  run(*command, "runner", File.join(root, "test/integration/queue_checks.rb"), directory: app)
end
