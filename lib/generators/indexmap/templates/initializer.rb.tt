# frozen_string_literal: true

module Indexmap
  module HostConfiguration
    MUTEX = Mutex.new

    def self.apply
      return if @applied

      MUTEX.synchronize do
        return if @applied

        require "indexmap"

        Indexmap.configure do |config|
          config.base_url = -> { ENV.fetch("INDEXMAP_BASE_URL", "http://localhost:3000") }
          config.storage = Indexmap::Storage::Filesystem.new(
            path: Rails.public_path,
            public_url: config.base_url
          )

          # Search-engine pings start from config.index_filename (default: "sitemap.xml").
          # Configure the sitemap data owned by your application:
          # config.sections = -> { Sitemap.sections }
        end

        @applied = true
      end
    end
  end
end

Indexmap::HostConfiguration.apply if defined?(Indexmap::Configuration)
